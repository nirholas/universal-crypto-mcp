{
  "name": "@nirholas/x402-deploy",
  "version": "0.1.0",
  "description": "1-click deployment and monetization for MCP servers and APIs with x402 payments",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "x402-deploy": "./dist/cli/index.js",
    "x402": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "x402",
    "mcp",
    "payments",
    "monetization",
    "deploy",
    "ai",
    "crypto"
  ],
  "author": "nirholas",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/x402-deploy.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@x402/core": "^0.4.0",
    "@x402/express": "^0.4.0",
    "@x402/evm": "^0.4.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.0",
    "enquirer": "^2.4.0",
    "express": "^4.18.0",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.0",
    "ora": "^8.0.0",
    "viem": "^2.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
