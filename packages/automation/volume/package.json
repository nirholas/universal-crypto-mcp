{
  "name": "@universal-crypto-mcp/automation-volume",
  "version": "1.0.0",
  "private": true,
  "description": "Volume generation, trading automation, and wallet management",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @boosty/mcp-server dev",
    "start": "pnpm --filter @boosty/mcp-server start",
    "db:init": "pnpm --filter @boosty/mcp-server db:init",
    "db:migrate": "pnpm --filter @boosty/mcp-server db:migrate",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nirholas"
  },
  "contributors": [
    {
      "name": "nich",
      "url": "https://github.com/nirholas",
      "twitter": "https://x.com/nichxbt"
    }
  ],
  "pnpm": {
    "overrides": {
      "@hono/node-server@1": "^2.1.3",
      "bigint-buffer": "npm:@exodus/bigint-buffer@1.1.5-exodus.1",
      "esbuild@0.18": "^0.25.0",
      "esbuild@0.19": "^0.25.0",
      "esbuild@0.27": "^0.28.1",
      "jayson@4": "^5.0.0",
      "minimatch@7": "^11.0.1",
      "minimatch@9": "^11.0.1",
      "protobufjs@6": "^7.6.5",
      "sharp@0.32": "^0.35.5",
      "toml@3": "^5.0.1",
      "uuid@8": "^11.1.1",
      "uuid@9": "^11.1.1",
      "zod@3": "^4.6.6"
    }
  }
}
