{
  "name": "@nirholas/crypto-automation-volume-packages-combined",
  "version": "0.1.0",
  "description": "Universal Crypto MCP - All-in-one DeFi MCP server combining prices, wallets, and yields",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "boosty-mcp": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "ts-node src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@boosty/mcp-shared": "workspace:@nirholas/crypto-automation-volume-packages-shared@*",
    "@boosty/mcp-prices": "workspace:@nirholas/crypto-automation-volume-packages-prices@*",
    "@boosty/mcp-wallets": "workspace:@nirholas/crypto-automation-volume-packages-wallets@*",
    "@boosty/mcp-yields": "workspace:@nirholas/crypto-automation-volume-packages-yields@*",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11",
    "ts-node": "^10.9.0",
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "defi",
    "prices",
    "wallets",
    "yields",
    "boosty"
  ],
  "license": "MIT",
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nirholas"
  },
  "contributors": [
    {
      "name": "nich",
      "url": "https://github.com/nirholas",
      "twitter": "https://x.com/nichxbt"
    }
  ]
}
