{
  "name": "@nirholas/crypto-automation-volume-packages-mcp-server",
  "version": "1.0.0",
  "description": "Universal Crypto MCP - Production DeFi operations MCP server for Solana with wallet management, trading, and volume campaigns",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "defi-mcp-server": "./dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "ts-node src/cli.ts",
    "start": "node dist/cli.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:init": "node dist/cli.js db:init",
    "db:migrate": "node dist/cli.js db:migrate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@boosty/mcp-shared": "workspace:@nirholas/crypto-automation-volume-packages-shared@*",
    "@boosty/mcp-orchestrator": "workspace:@nirholas/crypto-automation-volume-packages-orchestrator@*",
    "@boosty/mcp-wallet-manager": "workspace:@nirholas/crypto-automation-volume-packages-wallet-manager@*",
    "@boosty/mcp-trading-engine": "workspace:@nirholas/crypto-automation-volume-packages-trading-engine@*",
    "@solana/web3.js": "^1.91.3",
    "commander": "^12.0.0",
    "fastify": "^5.12.6",
    "ioredis": "^5.3.0",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "pino-pretty": "^10.3.0",
    "viem": "^2.0.0",
    "zod": "^4.6.6",
    "dotenv": "^16.3.0"
  },
  "optionalDependencies": {
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/svm": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11",
    "ts-node": "^10.9.0",
    "tsup": "^8.3.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "defi",
    "solana",
    "trading",
    "wallets",
    "volume-generation"
  ],
  "license": "MIT",
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nirholas"
  },
  "contributors": [
    {
      "name": "nich",
      "url": "https://github.com/nirholas",
      "twitter": "https://x.com/nichxbt"
    }
  ]
}
