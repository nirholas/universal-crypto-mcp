{
  "name": "@nirholas/agent-wallet",
  "version": "1.0.0",
  "description": "Wallet system for AI agents with spending controls and auto top-up",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "uuid": "^9.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "wallet",
    "x402",
    "payments",
    "mcp",
    "spending-limits"
  ],
  "author": "nirholas",
  "license": "Apache-2.0"
}
