{
  "name": "@universal-crypto-mcp/wallet-solana",
  "version": "1.0.0",
  "description": "Solana wallet tools for Universal Crypto MCP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wallet": {
      "import": "./dist/wallet.js",
      "types": "./dist/wallet.d.ts"
    },
    "./tools": {
      "import": "./dist/tools/index.js",
      "types": "./dist/tools/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nirholas/crypto-mcp-core": "workspace:*",
    "@universal-crypto-mcp/wallets-shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.0",
    "bs58": "^5.0.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/universal-crypto-mcp",
    "directory": "packages/wallets/solana"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "crypto",
    "wallet",
    "solana",
    "spl-token"
  ],
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  }
}
