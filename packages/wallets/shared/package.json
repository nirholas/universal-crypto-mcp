{
  "name": "@universal-crypto-mcp/wallets-shared",
  "version": "1.0.0",
  "description": "Shared wallet interfaces and utilities for Universal Crypto MCP",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./interfaces": {
      "import": "./dist/interfaces.js",
      "types": "./dist/interfaces.d.ts"
    },
    "./types": {
      "import": "./dist/types.js",
      "types": "./dist/types.d.ts"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "types": "./dist/utils.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/interfaces.ts src/types.ts src/utils.ts --format esm --dts",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/universal-crypto-mcp",
    "directory": "packages/wallets/shared"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "crypto",
    "wallet",
    "interfaces",
    "shared"
  ],
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  }
}
