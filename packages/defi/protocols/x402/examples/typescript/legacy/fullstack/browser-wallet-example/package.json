  "version": "1.0.0",
  "description": "Universal Crypto MCP - Example of x402 payments with browser wallet integration",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "install:all": "pnpm install && cd server && pnpm install && cd ../client && pnpm install",
    "preview": "cd client && pnpm preview"
  },
