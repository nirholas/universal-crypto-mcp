{
  "name": "@nirholas/crypto-defi-protocols-packages-infra-openbare",
  "version": "1.0.0",
  "description": "Universal Crypto MCP - A decentralized, censorship-resistant web proxy network",
  "private": true,
  "workspaces": [
    "server",
    "client",
    "registry"
  ],
  "scripts": {
    "start:server": "npm run start -w server",
    "start:registry": "npm run start -w registry",
    "dev:server": "npm run dev -w server",
    "dev:registry": "npm run dev -w registry",
    "install:all": "npm install --workspaces",
    "test": "npm test --workspaces --if-present",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "test:registry": "npm test -w registry",
    "lint": "npx eslint .",
    "lint:fix": "npx eslint . --fix",
    "format": "npx prettier --write \"**/*.{js,json,md}\"",
    "format:check": "npx prettier --check \"**/*.{js,json,md}\""
  },
  "keywords": [
    "proxy",
    "bare-server",
    "ultraviolet",
    "censorship-resistant",
    "decentralized",
    "web-proxy",
    "privacy"
  ],
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  },
  "license": "MIT",
