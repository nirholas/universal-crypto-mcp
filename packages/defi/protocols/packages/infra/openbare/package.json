    "type": "git",
    "url": "https://github.com/nirholas/universal-crypto-mcp",
    "directory": "packages/defi/protocols/packages/infra/openbare"
  },
  "homepage": "https://github.com/nirholas/openbare#readme",
  "bugs": {
    "url": "https://github.com/nirholas/openbare/issues"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "prettier": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "funding": {
