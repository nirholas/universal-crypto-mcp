{
  "name": "@nirholas/react-crypto-news",
  "version": "1.0.0",
  "description": "React components for Free Crypto News API - 100% free, no API keys!",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format cjs,esm --dts --external react",
    "dev": "tsup src/index.tsx --format cjs,esm --dts --external react --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "react": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "crypto",
    "news",
    "bitcoin",
    "ethereum",
    "defi",
    "web3",
    "component",
    "widget"
  ],
  "author": {
    "name": "nich",
    "url": "https://github.com/nirholas",
    "twitter": "https://x.com/nichxbt"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nirholas/universal-crypto-mcp",
    "directory": "packages/defi/protocols/packages/data/free-crypto-news/sdk/react"
  },
  "homepage": "https://free-crypto-news.vercel.app",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/nirholas"
  },
  "contributors": [
    {
      "name": "nich",
      "url": "https://github.com/nirholas",
      "twitter": "https://x.com/nichxbt"
    }
  ]
}
